#!/usr/bin/env bash
has_compile=0
has_asm_source=0
is_assembler_mode=0

prev=""
for arg in "$@"; do
    if [ "$arg" = "-c" ]; then
        has_compile=1
    fi

    case "$arg" in
        *.s|*.S|*.asm)
            has_asm_source=1
            ;;
    esac

    if [ "$prev" = "-x" ]; then
        case "$arg" in
            assembler|assembler-with-cpp)
                is_assembler_mode=1
                ;;
        esac
    fi

    prev="$arg"
done

if [ "$has_compile" = "1" ] && [ "$has_asm_source" = "0" ] && [ "$is_assembler_mode" = "0" ]; then
    exec "clang" -emit-llvm -fno-discard-value-names "$@"
else
    exec "clang" "$@"
fi
